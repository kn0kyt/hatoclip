<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hatoclip</AssemblyName>
    <RootNamespace>Hatoclip</RootNamespace>
    <ApplicationIcon>assets\hatoclip.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness (ApplicationConfiguration.Initialize); the QR window scales itself. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup Label="Version and metadata">
    <Version>1.0.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <!-- Keep ProductVersion (and the startup log line) as plain "1.0.0", without a "+<git hash>" suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Hatoclip</Product>
    <Company>Hatoclip</Company>
    <Copyright>Copyright (c) 2026 Hatoclip</Copyright>
    <Description>Hatoclip - LAN clipboard sharing between a phone and this PC</Description>
  </PropertyGroup>

  <PropertyGroup Label="Publish (see Properties\PublishProfiles and tools\publish.ps1)">
    <!-- Drop satellite resource assemblies of the framework; the UI strings are our own literals. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Single-file publish: bundle native libraries as well (no extraction folder), and compress the bundle. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No trimming and no ReadyToRun: WinForms and ASP.NET Core are not trim-safe; R2R roughly doubles the size. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web page, manifest and PWA icons served to the phone. Logical names: Hatoclip.Web.<file>.
         Icons are generated by tools/make-web-icons.ps1. -->
    <EmbeddedResource Include="Web\**\*" LogicalName="Hatoclip.Web.%(Filename)%(Extension)" />
    <!-- Tray icons: idle, "just received" and "just read by the phone" (generated by
         tools/make-tray-icons.ps1; replace the files in assets\ to rebrand). -->
    <EmbeddedResource Include="assets\*.ico" LogicalName="Hatoclip.assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hatoclip.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR code generation for the connection window (MIT). -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
