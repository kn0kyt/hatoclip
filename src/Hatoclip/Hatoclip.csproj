<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hatoclip</AssemblyName>
    <RootNamespace>Hatoclip</RootNamespace>
    <ApplicationIcon>assets\hatoclip.ico</ApplicationIcon>
    <Product>Hatoclip</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web page served to the phone. Logical names: Hatoclip.Web.<file> -->
    <EmbeddedResource Include="Web\**\*" LogicalName="Hatoclip.Web.%(Filename)%(Extension)" />
    <!-- Placeholder tray icon (replace assets\hatoclip.ico to rebrand). -->
    <EmbeddedResource Include="assets\hatoclip.ico" LogicalName="Hatoclip.assets.hatoclip.ico" />
  </ItemGroup>

</Project>
